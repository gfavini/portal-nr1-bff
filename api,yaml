openapi: 3.1.0
info:
  title: Survey Platform BFF API
  version: 1.0.0
  description: >
    Backend-for-frontend serving administrators and respondents. Respondents can only answer valid,
    non-expired questionnaires. Expired groups/questionnaires reject draft/submit attempts.
servers:
  - url: /api
security:
  - bearerAuth: []

tags:
  - name: Auth
  - name: Questionnaire
  - name: Groups
  - name: Respondent
  - name: Responses
  - name: Reports

paths:
  /auth/login:
    post:
      tags: [Auth]
      summary: Exchange credentials for a session
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/LoginRequest' }
      responses:
        '200':
          description: Authenticated
          content:
            application/json:
              schema: { $ref: '#/components/schemas/LoginResponse' }
        '400':
          description: Missing credentials
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                invalid:
                  value: { code: INVALID_LOGIN_PAYLOAD, message: 'Email and password are required.' }
        '401':
          description: Invalid credentials
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                unauthorized:
                  value: { code: INVALID_CREDENTIALS, message: 'The provided credentials are invalid.' }

  /auth/refresh:
    post:
      tags: [Auth]
      summary: Exchange a refresh token for a fresh access token and session
      description: Used by the client to silently refresh sessions before access token expiry.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                refreshToken: { type: string }
              required: [refreshToken]
      responses:
        '200':
          description: New session issued
          content:
            application/json:
              schema: { $ref: '#/components/schemas/LoginResponse' }
        '400':
          description: Missing or invalid refresh token
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                missing:
                  value: { code: MISSING_REFRESH_TOKEN, message: 'Refresh token is required.' }
                invalid:
                  value: { code: INVALID_REFRESH_TOKEN, message: 'The refresh token is invalid or expired.' }
        '401':
          description: Refresh token rejected (revoked/expired)
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                rejected:
                  value: { code: REFRESH_REJECTED, message: 'Session can no longer be refreshed; re-authentication required.' }

  /users/me:
    get:
      tags: [Auth]
      summary: Get current user session from bearer token
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Session info
          content:
            application/json:
              schema: { $ref: '#/components/schemas/LoginResponse' }
        '401':
          description: Missing or invalid token
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                invalid_token:
                  value: { code: INVALID_TOKEN, message: 'The access token is invalid or expired.' }

  /questionnaire:
    get:
      tags: [Questionnaire]
      summary: Get current questionnaire and history
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Current and historical versions
          content:
            application/json:
              schema: { $ref: '#/components/schemas/QuestionnaireHistoryResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /questionnaire/versions:
    post:
      tags: [Questionnaire]
      summary: Publish a new questionnaire version
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/PublishQuestionnaireVersionRequest' }
      responses:
        '201':
          description: Version published
          content:
            application/json:
              schema:
                type: object
                properties:
                  questionnaire:
                    $ref: '#/components/schemas/QuestionnaireVersion'
        '400':
          description: Invalid payload
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                invalid_payload:
                  value: { code: INVALID_PAYLOAD, message: 'Nova versão requer ao menos uma afirmação.' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /questionnaire/versions/{version}:
    get:
      tags: [Questionnaire]
      summary: Get a specific questionnaire version
      security:
        - bearerAuth: []
      parameters:
        - in: path
          name: version
          required: true
          schema: { type: integer }
      responses:
        '200':
          description: Requested version
          content:
            application/json:
              schema: { $ref: '#/components/schemas/QuestionnaireVersion' }
        '400':
          description: Invalid version
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                invalid_version:
                  value: { code: INVALID_VERSION, message: 'A versão solicitada é inválida.' }
        '404':
          description: Version not found
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                not_found:
                  value: { code: VERSION_NOT_FOUND, message: 'Versão X não encontrada.' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /questionnaire/import/preview:
    post:
      tags: [Questionnaire]
      summary: Validate and preview questionnaire CSV import
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/QuestionnaireCsvImportPayload' }
      responses:
        '200':
          description: Parsed preview (may include warnings)
          content:
            application/json:
              schema: { $ref: '#/components/schemas/QuestionnaireCsvImportResponse' }
        '400':
          description: Validation errors
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                missing_columns:
                  value: { code: CSV_IMPORT_MISSING_COLUMNS, message: 'Colunas obrigatórias ausentes: affirmation, pillar, subpillar.' }
                empty:
                  value: { code: CSV_IMPORT_EMPTY, message: 'O arquivo CSV está vazio.' }
                no_valid_rows:
                  value: { code: CSV_IMPORT_NO_VALID_ROWS, message: 'Nenhuma linha válida encontrada no CSV.' }
                invalid_payload:
                  value: { code: CSV_IMPORT_INVALID_PAYLOAD, message: 'Conteúdo do CSV é obrigatório.' }
        '401':
          $ref: '#/components/responses/Unauthorized'
        '500':
          description: Parsing failure
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                failed:
                  value: { code: CSV_IMPORT_FAILED, message: 'Não foi possível analisar o CSV.' }

  /groups:
    get:
      tags: [Groups]
      summary: List respondent groups
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Groups list
          content:
            application/json:
              schema: { $ref: '#/components/schemas/GroupsResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'
    post:
      tags: [Groups]
      summary: Create a respondent group
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/CreateGroupRequest' }
      responses:
        '201':
          description: Created
          content:
            application/json:
              schema: { $ref: '#/components/schemas/CreateGroupResponse' }
        '400':
          description: Validation or expiration errors
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                invalid_payload:
                  value: { code: INVALID_GROUP_PAYLOAD, message: 'Nome e ao menos um email são obrigatórios.' }
                past_expiration:
                  value: { code: GROUP_EXPIRATION_PAST, message: 'Expiration must be in the future.' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /groups/{groupId}:
    put:
      tags: [Groups]
      summary: Update a respondent group
      security:
        - bearerAuth: []
      parameters:
        - in: path
          name: groupId
          required: true
          schema: { type: string }
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/UpdateGroupRequest' }
      responses:
        '200':
          description: Updated
          content:
            application/json:
              schema: { $ref: '#/components/schemas/UpdateGroupResponse' }
        '400':
          description: Invalid payload or expired group without renewal
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                expired:
                  value: { code: GROUP_EXPIRED, message: 'Group is expired; provide a new expiresAt to reopen.' }
                invalid_payload:
                  value: { code: INVALID_GROUP_PAYLOAD, message: 'Payload inválido.' }
        '404':
          description: Group not found
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                not_found:
                  value: { code: GROUP_NOT_FOUND, message: 'Group not found.' }
        '401':
          $ref: '#/components/responses/Unauthorized'
    delete:
      tags: [Groups]
      summary: Delete a respondent group
      security:
        - bearerAuth: []
      parameters:
        - in: path
          name: groupId
          required: true
          schema: { type: string }
      responses:
        '200':
          description: Deleted
          content:
            application/json:
              schema: { $ref: '#/components/schemas/DeleteGroupResponse' }
        '400':
          description: Group closed or expired
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                closed:
                  value: { code: GROUP_CLOSED, message: 'Group is closed.' }
                expired:
                  value: { code: GROUP_EXPIRED, message: 'Group is expired.' }
        '404':
          description: Not found
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /groups/{groupId}/close:
    post:
      tags: [Groups]
      summary: Close a group (lock responses/invites)
      security:
        - bearerAuth: []
      parameters:
        - in: path
          name: groupId
          required: true
          schema: { type: string }
      responses:
        '200':
          description: Closed
          content:
            application/json:
              schema: { $ref: '#/components/schemas/GroupStatusChangeResponse' }
        '400':
          description: Group already closed/expired
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
        '404':
          description: Not found
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /groups/{groupId}/reopen:
    post:
      tags: [Groups]
      summary: Reopen a closed group (cannot reopen expired)
      security:
        - bearerAuth: []
      parameters:
        - in: path
          name: groupId
          required: true
          schema: { type: string }
      responses:
        '200':
          description: Reopened
          content:
            application/json:
              schema: { $ref: '#/components/schemas/GroupStatusChangeResponse' }
        '400':
          description: Group expired or invalid state
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                expired:
                  value: { code: GROUP_EXPIRED, message: 'Group is expired.' }
        '404':
          description: Not found
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /groups/{groupId}/send-invites:
    post:
      tags: [Groups]
      summary: Send invitations to all or selected respondents in the group
      security:
        - bearerAuth: []
      parameters:
        - in: path
          name: groupId
          required: true
          schema: { type: string }
      requestBody:
        required: false
        content:
          application/json:
            schema: { $ref: '#/components/schemas/SendInvitesRequest' }
      responses:
        '200':
          description: Invites sent
          content:
            application/json:
              schema: { $ref: '#/components/schemas/SendInvitesResponse' }
        '400':
          description: Validation failures
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                not_in_group:
                  value: { code: RESPONDENT_NOT_IN_GROUP, message: 'Some respondents are not in the group.' }
                invite_limit:
                  value: { code: INVITE_LIMIT_EXCEEDED, message: 'Cannot send more than 20 invites at once.' }
                group_closed:
                  value: { code: GROUP_CLOSED, message: 'Group is closed.' }
                group_expired:
                  value: { code: GROUP_EXPIRED, message: 'Group is expired.' }
        '404':
          description: Group not found
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /respondent/assignment:
    get:
      tags: [Respondent]
      summary: Get the questionnaire assignment for the authenticated respondent
      security:
        - bearerAuth: []
      responses:
        '200':
          description: Assignment or null
          content:
            application/json:
              schema: { $ref: '#/components/schemas/RespondentAssignmentResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /responses/draft:
    post:
      tags: [Responses]
      summary: Save draft answers (respondent)
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/SaveResponseRequest' }
      responses:
        '200':
          description: Draft saved
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Response' }
        '400':
          description: Invalid state (closed/expired/finalized)
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                expired:
                  value: { code: GROUP_EXPIRED, message: 'Group is expired.' }
                closed:
                  value: { code: GROUP_CLOSED, message: 'Group is closed.' }
                finalized:
                  value: { code: RESPONSE_FINALIZED, message: 'Response already submitted.' }
                not_assigned:
                  value: { code: RESPONDENT_NOT_ASSIGNED, message: 'No group assignment.' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /responses/submit:
    post:
      tags: [Responses]
      summary: Submit final answers (respondent)
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/SaveResponseRequest' }
      responses:
        '200':
          description: Submitted
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Response' }
        '400':
          description: Invalid state (closed/expired/finalized)
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
              examples:
                expired:
                  value: { code: GROUP_EXPIRED, message: 'Group is expired.' }
                closed:
                  value: { code: GROUP_CLOSED, message: 'Group is closed.' }
                finalized:
                  value: { code: RESPONSE_FINALIZED, message: 'Response already submitted.' }
                not_assigned:
                  value: { code: RESPONDENT_NOT_ASSIGNED, message: 'No group assignment.' }
        '401':
          $ref: '#/components/responses/Unauthorized'

  /reports:
    get:
      tags: [Reports]
      summary: Generate or fetch a report for a group/version
      security:
        - bearerAuth: []
      parameters:
        - in: query
          name: groupId
          required: true
          schema: { type: string }
        - in: query
          name: questionnaireVersion
          required: true
          schema: { type: integer }
      responses:
        '200':
          description: Report payload
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ReportResponse' }
        '400':
          description: Invalid params
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          description: Report not found
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }

  /reports/export:
    post:
      tags: [Reports]
      summary: Export a report and receive a download URL
      security:
        - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                groupId: { type: string }
                questionnaireVersion: { type: integer }
              required: [groupId, questionnaireVersion]
      responses:
        '200':
          description: Export enqueued or ready
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ReportExportResponse' }
        '400':
          description: Invalid params
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ErrorResponse' }
        '401':
          $ref: '#/components/responses/Unauthorized'

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  responses:
    Unauthorized:
      description: Unauthorized
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ErrorResponse' }
          examples:
            unauthorized:
              value: { code: INVALID_TOKEN, message: 'The access token is invalid or expired.' }

  schemas:
    LoginRequest:
      type: object
      required: [email, password]
      properties:
        email: { type: string, format: email }
        password: { type: string, format: password }

    LoginResponse:
      type: object
      properties:
        session:
          $ref: '#/components/schemas/AuthSession'
      required: [session]

    AuthSession:
      type: object
      properties:
        user: { $ref: '#/components/schemas/User' }
        tokens: { $ref: '#/components/schemas/AuthTokens' }
      required: [user, tokens]

    User:
      type: object
      properties:
        id: { type: string }
        email: { type: string, format: email }
        name: { type: string }
        roles:
          type: array
          items:
            enum: [ADMINISTRATOR, RESPONDENT]
      required: [id, email, roles]

    AuthTokens:
      type: object
      properties:
        accessToken: { type: string }
        refreshToken: { type: string }
        expiresAt: { type: string, format: date-time }
      required: [accessToken, expiresAt]

    QuestionnaireQuestion:
      type: object
      properties:
        id: { type: string }
        affirmation: { type: string }
        pillar: { type: string }
        subPillar: { type: string }
        required: { type: boolean, default: true }
      required: [id, affirmation, pillar, subPillar]

    QuestionnaireVersion:
      type: object
      properties:
        id: { type: string, description: 'Canonical questionnaire id (e.g., qre_001)' }
        version: { type: integer }
        publishedAt: { type: string, format: date-time }
        createdBy: { type: string }
        title: { type: string }
        description: { type: string }
        summary: { type: string }
        questions:
          type: array
          items: { $ref: '#/components/schemas/QuestionnaireQuestion' }
      required: [id, version, publishedAt, createdBy, questions]

    QuestionnaireHistoryResponse:
      type: object
      properties:
        current: { $ref: '#/components/schemas/QuestionnaireVersion' }
        versions:
          type: array
          items: { $ref: '#/components/schemas/QuestionnaireVersion' }
      required: [current, versions]

    PublishQuestionnaireVersionRequest:
      type: object
      properties:
        title: { type: string }
        description: { type: string }
        questions:
          type: array
          minItems: 1
          items: { $ref: '#/components/schemas/QuestionnaireQuestion' }
      required: [questions]

    QuestionnaireCsvImportPayload:
      type: object
      properties:
        filename: { type: string }
        content: { type: string, description: 'CSV file content (UTF-8)' }
      required: [filename, content]

    QuestionnaireCsvImportResponse:
      type: object
      properties:
        title: { type: string }
        description: { type: string }
        questions:
          type: array
          items: { $ref: '#/components/schemas/QuestionnaireQuestion' }
        warnings:
          type: array
          items: { type: string }
      required: [questions]

    RespondentGroup:
      type: object
      properties:
        id: { type: string }
        name: { type: string }
        respondentIds:
          type: array
          items: { type: string }
        assignedQuestionnaireId: { type: string }
        assignedQuestionnaireVersion: { type: integer }
        respondentEmails:
          type: array
          items: { type: string, format: email }
        status:
          type: string
          enum: [open, closed, expired]
        expiresAt: { type: string, format: date-time }
        lastInviteSentAt: { type: string, format: date-time }
        lastInviteScope:
          type: string
          enum: [all, partial]
      required:
        - id
        - name
        - respondentIds
        - assignedQuestionnaireId
        - assignedQuestionnaireVersion
        - status

    CreateGroupRequest:
      type: object
      properties:
        name: { type: string }
        respondentEmails:
          type: array
          minItems: 1
          items: { type: string, format: email }
        assignedQuestionnaireId: { type: string }
        assignedQuestionnaireVersion: { type: integer }
        status:
          type: string
          enum: [open, closed, expired]
        expiresAt: { type: string, format: date-time, description: 'Must be in the future' }
      required: [name, respondentEmails]

    CreateGroupResponse:
      type: object
      properties:
        groupId: { type: string }
        createdCount: { type: integer }
      required: [groupId, createdCount]

    UpdateGroupRequest:
      type: object
      properties:
        name: { type: string }
        respondentEmails:
          type: array
          minItems: 1
          items: { type: string, format: email }
        assignedQuestionnaireId: { type: string }
        assignedQuestionnaireVersion: { type: integer }
        expiresAt: { type: string, format: date-time }
      required: [name, respondentEmails, assignedQuestionnaireId, assignedQuestionnaireVersion]

    UpdateGroupResponse:
      type: object
      properties:
        group: { $ref: '#/components/schemas/RespondentGroup' }
        updatedCount: { type: integer }
      required: [group, updatedCount]

    GroupStatusChangeResponse:
      type: object
      properties:
        group: { $ref: '#/components/schemas/RespondentGroup' }
      required: [group]

    GroupsResponse:
      type: object
      properties:
        groups:
          type: array
          items: { $ref: '#/components/schemas/RespondentGroup' }
      required: [groups]

    SendInvitesRequest:
      type: object
      properties:
        messageTemplate: { type: string }
        respondentIds:
          type: array
          items: { type: string }
          description: 'Optional targeted send; must belong to the group; max 20'
    SendInvitesResponse:
      type: object
      properties:
        sent: { type: integer }
        lastInviteSentAt: { type: string, format: date-time }
        lastInviteScope:
          type: string
          enum: [all, partial]
        group: { $ref: '#/components/schemas/RespondentGroup' }
      required: [sent]

    DeleteGroupResponse:
      type: object
      properties:
        groupId: { type: string }
      required: [groupId]

    RespondentAssignment:
      type: object
      properties:
        group: { $ref: '#/components/schemas/RespondentGroup' }
        questionnaire: { $ref: '#/components/schemas/QuestionnaireVersion' }
        existingResponse: { $ref: '#/components/schemas/Response' }
      required: [group, questionnaire]

    RespondentAssignmentResponse:
      type: object
      properties:
        assignment:
          oneOf:
            - $ref: '#/components/schemas/RespondentAssignment'
            - type: 'null'
      required: [assignment]

    ResponseAnswer:
      type: object
      properties:
        questionId: { type: string }
        value:
          type: integer
          minimum: 0
          maximum: 10
      required: [questionId, value]

    Response:
      type: object
      properties:
        id: { type: string }
        questionnaireId: { type: string }
        questionnaireVersion: { type: integer }
        respondentId: { type: string }
        answers:
          type: array
          items: { $ref: '#/components/schemas/ResponseAnswer' }
        visitedQuestionIds:
          type: array
          items: { type: string }
        status:
          type: string
          enum: [draft, submitted]
        savedAt: { type: string, format: date-time }
        submittedAt: { type: string, format: date-time }
      required:
        - id
        - questionnaireId
        - questionnaireVersion
        - respondentId
        - answers
        - visitedQuestionIds
        - status
        - savedAt

    SaveResponseRequest:
      type: object
      properties:
        questionnaireId: { type: string }
        questionnaireVersion: { type: integer }
        respondentId: { type: string }
        answers:
          type: array
          items: { $ref: '#/components/schemas/ResponseAnswer' }
        visitedQuestionIds:
          type: array
          items: { type: string }
        status:
          type: string
          enum: [draft, submitted]
      required:
        - questionnaireId
        - questionnaireVersion
        - respondentId
        - answers
        - visitedQuestionIds
        - status

    ReportQuestionSummary:
      type: object
      properties:
        questionId: { type: string }
        affirmation: { type: string }
        pillar: { type: string }
        subPillar: { type: string }
        required: { type: boolean }
        average: { type: number }
        min: { type: number }
        max: { type: number }
        responses: { type: integer }
      required: [questionId, affirmation, pillar, subPillar, required, average, min, max, responses]

    ReportSummary:
      type: object
      properties:
        respondentCount: { type: integer }
        overallAverage: { type: number }
        questionSummaries:
          type: array
          items: { $ref: '#/components/schemas/ReportQuestionSummary' }
      required: [respondentCount, overallAverage, questionSummaries]

    Report:
      type: object
      properties:
        id: { type: string }
        questionnaireId: { type: string }
        questionnaireVersion: { type: integer }
        groupId: { type: string }
        generatedAt: { type: string, format: date-time }
        summary: { $ref: '#/components/schemas/ReportSummary' }
        downloadUrl: { type: string, format: uri }
      required: [id, questionnaireId, questionnaireVersion, groupId, generatedAt, summary]

    ReportResponse:
      type: object
      properties:
        report: { $ref: '#/components/schemas/Report' }
      required: [report]

    ReportExportResponse:
      type: object
      properties:
        downloadUrl: { type: string, format: uri }
      required: [downloadUrl]

    ErrorResponse:
      type: object
      properties:
        code: { type: string }
        message: { type: string }
        details: { type: object, additionalProperties: true }
      required: [code, message]